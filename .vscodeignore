# Everything is excluded except the bundled output and the assets package.json
# references (icons, syntaxes). Source is bundled into dist/ by vite, so src/,
# node_modules/ and tooling are not shipped.
**

!dist/extension.js
!icons/**
!syntaxes/**
!LICENSE.md
!README.md
!CHANGELOG.md
!package.json

# vscode-languageclient + transitive deps are not bundled (see vite.config.mjs);
# ship them so the runtime `require` resolves.
!node_modules/vscode-languageclient/**
!node_modules/vscode-languageserver-protocol/**
!node_modules/vscode-languageserver-types/**
!node_modules/vscode-jsonrpc/**
!node_modules/semver/**
!node_modules/minimatch/**
!node_modules/brace-expansion/**
!node_modules/balanced-match/**
!node_modules/concat-map/**

# Re-exclude maps even if they land in dist/
**/*.map
**/.DS_Store
